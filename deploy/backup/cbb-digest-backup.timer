[Unit]
Description=Nightly B2 backup of the cbb-digest database

[Timer]
# Daily, so Monday's 07:00 run is on the drive and on B2 by Tuesday morning, and clear of Navidrome's
# 04:00 backup. The zone is named rather than left to the host's, so this is 05:30 Eastern, as the
# digest's schedule is, whatever the host is set to.
OnCalendar=*-*-* 05:30 America/New_York
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target

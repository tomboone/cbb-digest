# Copy to ~/.config/cbb-digest-backup.env (mode 600) on kumadrome and fill in. Not committed.

MOUNT_POINT=/mnt/music
# Where the copies are kept on the USB drive.
BACKUP_DIR=/mnt/music/cbb-digest/backups
# Days of copies kept in BACKUP_DIR, and so on B2.
KEEP_DAYS=14

# rclone destination, in the bucket the Navidrome backup uses. The remote name ("b2") is the one in
# tom's rclone.conf.
REMOTE=b2:<bucket>/cbb-digest-backups

# Optional: the push URL of the kumadrome/cbb-digest-backup push monitor on the Kuma on kumadrome
# (heartbeat interval 25 h). Keep the double quotes: this file is sourced, and an unquoted & (Kuma's
# default "?status=up&msg=OK&ping=" query) sends the assignment to the background, leaving PING_URL
# unset and the ping silently skipped. The query itself is dropped by the script either way.
PING_URL="http://127.0.0.1:3001/api/push/<token>"

# cbb-digest runtime configuration (spec §9.5). Copy to `.env` and fill in; on kumadrome it sits
# beside deploy/docker-compose.yml (spec §10).
# Commented-out values are the defaults; blank ones are unset. The season is not configured
# here: it comes from watchlist.yaml.

# Directory for the source cache, the SQLite database and out/; the container mounts it at /data.
# DATA_DIR=/data

# Required: CollegeBasketballData API key (https://collegebasketballdata.com). The free key
# shares its quota with CollegeFootballData.
CBBD_API_KEY=

# Required: comma-separated recipient addresses.
RECIPIENTS=tom@tomboone.com

# Resend transport (primary): set both to enable.
RESEND_API_KEY=
RESEND_FROM=CBB Digest <cbb@tomboone.com>

# SMTP transport (optional fallback): set credentials and sender to enable.
# SMTP_HOST=smtp.fastmail.com
# SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_ADDRESS=

# healthchecks.io ping URL (https://hc-ping.com/<uuid>); unset disables the ping. Pinged every
# scheduled Monday, sent or skipped, and at `/fail` with a reason on failure. Check settings:
# period 7 days, grace 26 hours.
HEALTHCHECKS_URL=

# true renders to out/ instead of sending.
# DRY_RUN=false

# Git SHA of the image, baked in at build time; leave unset in .env.
# IMAGE_SHA=

# LOG_LEVEL=INFO
